<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title><%= typeof code !== 'undefined' ? code : '404' %> — Prep Tracker</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<main class="center-page">
    <div class="code"><%= typeof code !== 'undefined' ? code : '404' %></div>
    <h2><%= typeof message !== 'undefined' && message ? message : "That page doesn't exist." %></h2>
    <p>Head back to your dashboard to continue.</p>
    <a href="/dashboard" class="btn" style="margin-top:12px;">Back to dashboard</a>
</main>
</body>
</html>
